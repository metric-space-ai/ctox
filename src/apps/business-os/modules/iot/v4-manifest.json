{
  "_basis": {
    "multi_instance": "v4/frame/INTEGRATION.md FR2-4 (Apps mit modulweitem Zustand: multi_instance:false)",
    "triggers": "modules/iot/V4-HANDLERS.md „Trigger“ (Manifest-Eintrag für den Generator)"
  },
  "_format": "ctox-shell-v4-app-declaration-1",
  "_note": "Deklaration für gen-manifest.mjs (Strang MAN): nur Angaben, die sich nicht aus dem Code ableiten lassen. _basis = Fundstelle je Feld.",
  "multi_instance": false,
  "triggers": [
    {
      "handler": "handlers/ctox.iot.signal.evaluate.js",
      "on": {
        "collection": "iot_attributes",
        "op": "insert"
      }
    },
    {
      "handler": "handlers/ctox.iot.signal.evaluate.js",
      "on": {
        "collection": "iot_attributes",
        "op": "update"
      }
    },
    {
      "every": "PT1M",
      "handler": "handlers/ctox.iot.rules.tick.js"
    }
  ]
}
