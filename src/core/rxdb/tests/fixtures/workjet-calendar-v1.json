{
  "schema": "ctox.workjet.calendar.v1",
  "contract_version": 1,
  "export_prefix": "CALENDAR",
  "types": {
    "CalendarKind": {
      "enum": [
        "local",
        "project_meeting",
        "synced",
        "project_session"
      ]
    },
    "CalendarEvent": {
      "fields": {
        "id": {
          "type": "String",
          "min_chars": 1,
          "max_chars": 128
        },
        "calendar_id": {
          "type": "String",
          "min_chars": 1,
          "max_chars": 128
        },
        "kind": {
          "type": "CalendarKind"
        },
        "title": {
          "type": "String",
          "min_chars": 1,
          "max_chars": 256
        },
        "start_ms": {
          "type": "i64"
        },
        "end_ms": {
          "type": "i64"
        },
        "all_day": {
          "type": "bool"
        },
        "timezone": {
          "type": "String",
          "min_chars": 1,
          "max_chars": 128
        },
        "location": {
          "type": "String",
          "max_chars": 512,
          "optional": true
        },
        "notes": {
          "type": "String",
          "max_chars": 4096,
          "optional": true
        },
        "revision": {
          "type": "u64"
        },
        "project_id": {
          "type": "String",
          "min_chars": 1,
          "max_chars": 256,
          "optional": true
        },
        "session_id": {
          "type": "String",
          "min_chars": 1,
          "max_chars": 256,
          "optional": true
        },
        "account_id": {
          "type": "String",
          "min_chars": 1,
          "max_chars": 256,
          "optional": true
        },
        "external_id": {
          "type": "String",
          "min_chars": 1,
          "max_chars": 256,
          "optional": true
        }
      },
      "ordered_fields": [
        {
          "before": "start_ms",
          "after": "end_ms"
        }
      ]
    },
    "CalendarEventUpdate": {
      "fields": {
        "expected_revision": {
          "type": "u64"
        },
        "event": {
          "type": "CalendarEvent"
        }
      }
    },
    "CalendarEventDelete": {
      "fields": {
        "id": {
          "type": "String",
          "min_chars": 1,
          "max_chars": 128
        },
        "expected_revision": {
          "type": "u64"
        }
      }
    }
  },
  "commands": {
    "ctox.workjet.calendar.event.create": {
      "request_type": "CalendarEvent",
      "authorization": "owner"
    },
    "ctox.workjet.calendar.event.update": {
      "request_type": "CalendarEventUpdate",
      "authorization": "owner"
    },
    "ctox.workjet.calendar.event.delete": {
      "request_type": "CalendarEventDelete",
      "authorization": "owner"
    }
  },
