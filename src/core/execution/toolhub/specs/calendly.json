          },
          "sort": {
            "arg": "sort",
            "trim": true
          },
          "count": {
            "arg": "count",
            "default": 20,
            "clamp": [
              1,
              100
            ]
          },
          "page_token": {
            "arg": "page_token",
            "trim": true
          }
        }
      },
      "response": {
        "mode": "object",
        "fields": {
          "collection": {
            "pointer": "/collection",
