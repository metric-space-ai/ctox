              "trim": true,
              "required": true
            },
            "color": {
              "arg": "color",
              "required": true,
              "one_of": [
                "green",
                "yellow",
                "orange",
                "red",
                "purple",
                "blue",
                "sky",
                "lime",
                "pink",
                "black"
              ]
            }
          }
        }
      }
    },
    {
