    {
      "slug": "TRELLO_ADD_CHECKLIST_ITEM",
      "title": {
        "de": "Checklisten-Punkt hinzufügen",
        "en": "Add checklist item"
      },
      "description": {
        "de": "Fügt einer Checkliste einen Punkt hinzu.",
        "en": "Adds an item to a checklist."
      },
      "risk": "write",
      "scopes": [
        "write"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "checklist": {
            "type": "string",
            "description": "Checklisten-ID (aus TRELLO_ADD_CHECKLIST)."
          },
          "name": {
            "type": "string",
            "description": "Text des Punkts."
