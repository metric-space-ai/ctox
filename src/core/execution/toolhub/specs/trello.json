            "type": "string",
            "description": "Board-ID (24 Zeichen) oder Kurz-ID aus der Board-URL."
          },
          "name": {
            "type": "string",
            "description": "Labelname."
          },
          "color": {
            "type": "string",
            "enum": [
              "green",
              "yellow",
