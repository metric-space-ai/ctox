    },
    {
      "description": {
        "de": "Findet Datensätze, in denen ein Feld einen Wert enthält oder exakt gleich ist.",
        "en": "Finds records where a field contains or exactly equals a value."
      },
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "base_id": {
            "description": "Base-ID (appXXXXXXXXXXXXXX), auflösen mit AIRTABLE_LIST_BASES",
            "type": "string"
          },
          "match_mode": {
            "description": "contains (Standard) oder exact",
            "enum": [
              "contains",
              "exact"
            ],
            "type": "string"
          },
          "max_records": {
            "description": "Höchstzahl passender Datensätze",
            "maximum": 100000,
            "minimum": 1,
            "type": "integer"
          },
          "search_field": {
            "description": "Exakter Feldname",
            "type": "string"
          },
          "search_value": {
            "description": "Gesuchter Wert",
            "type": "string"
          },
          "table_id_or_name": {
            "description": "Table-ID (tblXXXXXXXXXXXXXX) oder exakter Tabellenname",
            "type": "string"
          },
          "view": {
            "description": "View-ID oder -Name; leer = ganze Tabelle",
            "type": "string"
          }
        },
        "required": [
          "base_id",
          "table_id_or_name",
          "search_field",
          "search_value"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/{base_id}/{table_id_or_name}",
        "query": {
          "filterByFormula": {
            "switch": "match_mode",
            "default": "contains",
            "cases": {
              "contains": {
                "template": "FIND(\"{search_value}\",{{{search_field}}})",
                "escape": {
                  "search_value": "backslash_quote"
                },
                "forbid": {
                  "search_field": "{}"
                }
              },
              "exact": {
                "template": "{{{search_field}}}&\"\"=\"{search_value}\"",
                "escape": {
                  "search_value": "backslash_quote"
                },
                "forbid": {
                  "search_field": "{}"
                }
              }
            }
          },
          "view": {
            "arg": "view",
            "trim": true
          },
          "maxRecords": {
            "arg": "max_records",
            "clamp": [
              1,
              100000
            ]
          }
        },
        "path_encoding": {
          "table_id_or_name": "component"
        }
      },
      "response": {
        "mode": "object",
        "fields": {
          "records": {
            "pointer": "/records",
            "each": {
              "id": "/id",
              "created_time": "/createdTime",
              "fields": "/fields"
            }
          },
          "count": {
            "pointer": "/records",
            "count": true
          }
        }
      },
      "risk": "read",
      "scopes": [
        "data.records:read"
      ],
      "slug": "AIRTABLE_SEARCH_RECORDS",
      "title": {
        "de": "Datensätze suchen",
        "en": "Search records"
      }
    },
    {
      "description": {
