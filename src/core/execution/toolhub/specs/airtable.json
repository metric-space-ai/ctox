    {
      "description": {
        "de": "Listet Datensätze einer Tabelle, optional mit Formel, View, Sortierung und Feldwahl.",
        "en": "Lists records of a table, optionally with formula, view, sorting and field selection."
      },
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "base_id": {
            "description": "Base-ID (appXXXXXXXXXXXXXX), auflösen mit AIRTABLE_LIST_BASES",
            "type": "string"
          },
          "fields": {
            "description": "Feldnamen, die zurückgegeben werden sollen",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "filter_by_formula": {
            "description": "Airtable-Formel, z. B. {Status}=\"Done\"",
            "type": "string"
          },
          "max_records": {
            "description": "Höchstzahl zurückgegebener Datensätze",
            "maximum": 100000,
            "minimum": 1,
            "type": "integer"
          },
          "offset": {
            "description": "Offset eines vorherigen Aufrufs zum Weiterblättern",
            "type": "string"
          },
          "page_size": {
            "description": "Datensätze pro Seite (1–100)",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "sort": {
            "description": "JSON-Array, z. B. [{\"field\":\"Name\",\"direction\":\"asc\"}]",
            "type": "array"
          },
          "table_id_or_name": {
            "description": "Table-ID (tblXXXXXXXXXXXXXX) oder exakter Tabellenname",
            "type": "string"
          },
          "view": {
            "description": "View-ID oder -Name; leer = ganze Tabelle",
            "type": "string"
          }
        },
        "required": [
          "base_id",
          "table_id_or_name"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/{base_id}/{table_id_or_name}",
        "query": {
          "filterByFormula": {
            "arg": "filter_by_formula",
            "trim": true
          },
          "view": {
            "arg": "view",
            "trim": true
          },
          "maxRecords": {
            "arg": "max_records",
            "clamp": [
              1,
              100000
            ]
          },
          "pageSize": {
            "arg": "page_size",
            "clamp": [
              1,
              100
            ]
          },
          "offset": {
            "arg": "offset",
            "trim": true
          },
          "sort": {
            "arg": "sort",
            "type": "raw",
            "wrap_object": true,
            "require_key": "field"
          },
          "fields": {
            "arg": "fields",
            "type": "string_list"
          }
        },
        "path_encoding": {
          "table_id_or_name": "component"
        }
      },
      "response": {
        "mode": "object",
        "fields": {
          "records": {
            "pointer": "/records",
            "each": {
              "id": "/id",
              "created_time": "/createdTime",
              "fields": "/fields"
            }
          },
          "count": {
            "pointer": "/records",
            "count": true
          },
          "offset": {
            "pointer": "/offset"
          }
        }
      },
      "risk": "read",
      "scopes": [
        "data.records:read"
      ],
      "slug": "AIRTABLE_LIST_RECORDS",
      "title": {
