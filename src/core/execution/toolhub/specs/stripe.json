            "description": "Sofort ausführen."
          },
          "description": {
            "type": "string",
            "description": "Beschreibung."
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Eigene Schlüssel/Werte (metadata[key]=value), z. B. {\"order\":\"42\"}."
          }
        },
        "required": [
