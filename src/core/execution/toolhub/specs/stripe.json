            "type": "string",
            "description": "Währung, z. B. eur."
          },
          "customer": {
            "type": "string",
            "description": "Optional: Kunden-ID."
          },
          "payment_method": {
            "type": "string",
            "description": "Zahlungsmittel-ID; im Testmodus z. B. pm_card_visa."
          },
