            "type": "number",
            "description": "Suchradius für Stationen um die geografische Position oder den angegebenen Flusskilometer. Longitude und / oder Latitude oder km sind notwendig."
          }
        },
        "required": []
      },
      "request": {
        "method": "GET",
        "path": "/stations.json",
        "query": {
          "includeTimeseries": {
            "arg": "includeTimeseries",
            "type": "boolean"
          },
          "includeCurrentMeasurement": {
            "arg": "includeCurrentMeasurement",
            "type": "boolean"
          },
          "includeCharacteristicValues": {
            "arg": "includeCharacteristicValues",
            "type": "boolean"
          },
          "waters": {
            "arg": "waters",
            "type": "string_list",
            "join": ","
          },
          "ids": {
            "arg": "ids",
            "type": "string_list",
            "join": ","
          },
          "timeseries": {
            "arg": "timeseries",
            "type": "string"
          },
          "fuzzyId": {
            "arg": "fuzzyId",
            "type": "string"
          },
          "latitude": {
            "arg": "latitude",
            "type": "number"
          },
          "longitude": {
            "arg": "longitude",
            "type": "number"
          },
          "km": {
            "arg": "km",
            "type": "number"
          },
          "radius": {
            "arg": "radius",
            "type": "number"
          }
        }
      },
      "response": {
        "mode": "body"
      }
    },
