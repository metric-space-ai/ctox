    {
      "slug": "PEGEL_ONLINE_GET_MEASUREMENT_BY_STATION",
      "title": {
        "de": "Zugriff auf die Ressource Measurement",
        "en": "Zugriff auf die Ressource Measurement"
      },
      "description": {
        "de": "Es handeln sich dabei um die gemessenen Rohwerte. Es können maximal Werte der letzten 31 Tage bezogen werden.",
        "en": "Es handeln sich dabei um die gemessenen Rohwerte. Es können maximal Werte der letzten 31 Tage bezogen werden."
      },
      "risk": "read",
      "scopes": [],
