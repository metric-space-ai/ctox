          "start": {
            "arg": "start",
            "type": "string"
          },
          "end": {
            "arg": "end",
            "type": "string"
          }
        },
        "path_encoding": {
          "station": "component",
          "timeseries": "component"
        }
      },
      "response": {
        "mode": "body"
      }
    },
