        "en": "Übersicht über alle Stationen (Pegel)"
      },
      "description": {
        "de": "Stationen (Pegel) sortiert nach Gewässername und Messstellenname.",
        "en": "Stationen (Pegel) sortiert nach Gewässername und Messstellenname."
      },
      "risk": "read",
      "scopes": [],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "includeTimeseries": {
            "type": "boolean",
            "description": "Informationen zu den Zeitreihen"
          },
          "includeCurrentMeasurement": {
            "type": "boolean",
            "description": "Aktuell gemessener Wert"
          },
          "includeCharacteristicValues": {
            "type": "boolean",
            "description": "kennzeichnende Wasserstände"
          },
          "waters": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "description": "Gewässer, filtert Stationen für bestimmte Gewässer"
          },
          "ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "description": "Filter nach Stationen, möglich sind der Pegelname, Pegelnummer oder die UUID"
          },
          "timeseries": {
            "type": "string",
            "description": "Filter nach ausgewählten Zeitreihen"
          },
          "fuzzyId": {
            "type": "string"
          },
          "latitude": {
            "type": "number",
