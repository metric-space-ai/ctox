        "required": [
          "page_id"
        ],
        "type": "object"
      },
      "request": {
        "headers": {
          "notion-version": "2022-02-22"
        },
        "method": "GET",
        "path": "/pages/{page_id}"
      },
      "risk": "read",
      "scopes": [],
      "slug": "NOTION_GET_PAGE",
      "title": {
        "de": "Seite lesen",
        "en": "Get page"
      }
    },
    {
      "description": {
        "de": "Fragt eine Datenbank mit Notions nativen Filter- und Sortier-JSON-Objekten ab (UND/ODER, Bereiche, enthält).",
        "en": "Queries a database using Notion's native filter and sort JSON (AND/OR, ranges, contains)."
      },
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "database_id": {
            "description": "Datenbank-ID / database id",
            "type": "string"
          },
          "filter": {
            "description": "Optionales Notion-Filter-Objekt / optional Notion filter object",
            "type": "object"
          },
          "page_size": {
            "default": 100,
            "description": "Maximale Zeilen (1-100) / max rows",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "sorts": {
            "description": "Optionale Notion-Sortierobjekte / optional Notion sort objects",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "start_cursor": {
            "description": "Paginierungscursor / pagination cursor",
            "type": "string"
          }
        },
        "required": [
          "database_id"
        ],
        "type": "object"
      },
      "request": {
        "body": {
          "json": {
            "filter": {
              "arg": "filter"
            },
            "page_size": {
              "arg": "page_size",
              "default": 100
            },
            "sorts": {
              "arg": "sorts",
              "type": "raw"
            },
            "start_cursor": {
              "arg": "start_cursor",
              "trim": true
            }
          }
        },
        "headers": {
          "notion-version": "2022-02-22"
        },
        "method": "POST",
        "path": "/databases/{database_id}/query",
        "read_only_post": true
      },
      "response": {
        "fields": {
          "count": {
            "count": true,
            "pointer": "/results"
          },
          "has_more": {
            "pointer": "/has_more"
          },
          "next_cursor": {
            "pointer": "/next_cursor"
          },
          "results": {
            "default": [],
            "pointer": "/results"
          },
          "success": {
            "default": true,
            "pointer": "/__ctox_missing__"
          }
        },
        "mode": "object"
      },
      "risk": "read",
      "scopes": [],
      "slug": "NOTION_QUERY_DATABASE",
      "title": {
        "de": "Datenbank abfragen",
        "en": "Query database"
      }
    },
    {
